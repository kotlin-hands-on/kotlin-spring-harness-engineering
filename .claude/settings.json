{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/detekt_changed_file.py\"",
            "timeout": 180,
            "statusMessage": "detekt on edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/test_changed_modules.py\"",
            "timeout": 900,
            "statusMessage": "Testing changed Gradle projects"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer|general-purpose",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/test_changed_modules.py\"",
            "timeout": 900,
            "statusMessage": "Testing changed Gradle projects"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/test_changed_modules.py\"",
            "timeout": 900,
            "statusMessage": "Testing changed Gradle projects"
          }
        ]
      }
    ]
  }
}
