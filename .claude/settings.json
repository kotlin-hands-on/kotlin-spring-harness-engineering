{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/preflight.py\"",
            "timeout": 10,
            "statusMessage": "Harness preflight"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jbcontext index --silent --only-incremental",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/detekt_changed_file.py\"",
            "timeout": 180,
            "statusMessage": "detekt on edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_changed_modules.py\"",
            "timeout": 900,
            "statusMessage": "Running check on changed Gradle projects"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer|general-purpose",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_changed_modules.py\"",
            "timeout": 900,
            "statusMessage": "Running check on changed Gradle projects"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_changed_modules.py\"",
            "timeout": 900,
            "statusMessage": "Running check on changed Gradle projects"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jbcontext index --silent --only-incremental",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "kotlin-lsp@claude-plugins-official": true
  },
  "enableAllProjectMcpServers": true
}
